# 直接 go run 不自动加载 .env；Docker Compose 会读取项目根目录的 .env。
# 未设置时默认监听 127.0.0.1:8080。
HTTP_ADDR=127.0.0.1:8080
# 先创建数据库并执行 migrations/001_init.sql，再启动服务。
MYSQL_DSN='audio:replace_me@tcp(127.0.0.1:3306)/audio_recording'
UPLOAD_DIR=./uploads
# 复制到本地 .env 后填写真实密钥；.env 不提交 Git。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Docker Compose：仅暴露 HTTP；MySQL 在容器网络内访问。
HTTP_PORT=8080
MYSQL_PASSWORD=audio_local_dev
MYSQL_ROOT_PASSWORD=audio_root_local_dev
# 构建镜像时下载 Go 依赖的代理，可按网络环境调整。
GOPROXY=https://goproxy.cn,direct
